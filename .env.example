# Copy to .env and adjust for your environment.
# Postgres connection used by SQLAlchemy (psycopg3 driver).
DATABASE_URL=postgresql+psycopg://ledgerhound:ledgerhound@localhost:5432/ledgerhound

# HTTP client behavior for collectors.
HTTP_TIMEOUT_SECONDS=15
HTTP_USER_AGENT=Ledgerhound/0.1 (+https://github.com/ledgerhound/ledgerhound; threat-intel collection bot)
HTTP_MAX_ATTEMPTS=3
HTTP_BACKOFF_SECONDS=1.0

# Path to the source registry consumed by `lh collect`.
SOURCES_CONFIG_PATH=config/sources.yaml

# Path to the per-provider rate-limit/TTL tuning file consumed by `lh enrich`.
PROVIDERS_CONFIG_PATH=config/providers.yaml

# Enrichment (`lh enrich` / `lh trace` / `lh providers`). No API key is
# required for any provider Ledgerhound ships with.
ENRICH_CONCURRENCY=5
ENRICH_DEFAULT_TTL_HOURS=6.0
OFAC_CACHE_PATH=.cache/ofac_sdn.xml
RDAP_BOOTSTRAP_CACHE_PATH=.cache/rdap_bootstrap.json
# Override to point at your own mixer/bridge/exchange dataset instead of
# the bundled one (see enrich/labels/data/known_addresses.yaml).
# KNOWN_ADDRESSES_PATH=

# Path to the relation-weight/campaign-threshold tuning file consumed by
# `lh cluster run`.
CLUSTERING_CONFIG_PATH=config/clustering.yaml

# Assessment (`lh assess draft`). Required only for that command — every
# other command works with no key set. LLM_BASE_URL accepts any
# OpenAI-compatible chat-completions endpoint — OpenAI itself, Azure
# OpenAI, Ollama, LM Studio, Groq, Together, OpenRouter, vLLM, etc.
# LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
ATTACK_STIX_CACHE_PATH=.cache/attack_enterprise.json

# Export & reports (`lh export ...` / `lh report render` / `lh publish`).
# No API key or network access needed for any of it.
EXPORT_OUTPUT_PATH=published
REPORTS_PATH=reports
TLP_DEFAULT=TLP:CLEAR

# Logging
LOG_LEVEL=INFO
LOG_JSON=false
